{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "status",
    "run_id",
    "product_manifest_sha256",
    "source_sha256",
    "artifact_sha256",
    "environment",
    "cases",
    "measurements",
    "cleanup",
    "diagnostic"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "suite": {"const": "FocusConditionalProduct"},
    "status": {"enum": ["PASS", "DIAGNOSTIC"]},
    "run_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "product_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment": {"type": "object"},
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "name", "status", "details"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 12},
          "name": {
            "enum": [
              "backend_is_cf",
              "single_cell_two_rules",
              "range_a1_c3_outer_axes",
              "shape_modes_and_selection_option",
              "five_hundred_moves_exact_two_rules",
              "move_p95_within_50ms",
              "saved_state_preserved",
              "native_undo_preserved",
              "user_rules_unchanged",
              "paste_has_no_duplicates",
              "protected_sheet_safe_exclusion",
              "disable_cleanup_zero_assets"
            ]
          },
          "status": {"enum": ["PASS", "FAIL"]},
          "details": {"type": "object"}
        }
      }
    },
    "measurements": {"type": "object"},
    "cleanup": {"type": "object"},
    "diagnostic": {"type": ["string", "null"]}
  }
}
